{
  "name": "ai-cyberwar-rts",
  "version": "0.0.1",
  "private": true,
  "description": "Open-source RTS where humans fight an LLM-commanded AI faction for compute, bandwidth, and data.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
